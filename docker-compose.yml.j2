services:
  # 1. SOVEREIGN SOURCE CONTROL (Forgejo)
  forgejo:
    image: codeberg.org/forgejo/forgejo:16
    container_name: forgejo
    environment:
      - USER_UID=${HOST_UID}
      - USER_GID=${HOST_GID}
    volumes:
      - /var/lib/forgejo:/data
      - /etc/forgejo:/data/gitea/conf
      - /etc/forgejo/ssh:/data/git/.ssh
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ tailscale_ip }}:3000:3000"
      - "{{ tailscale_ip }}:2222:22"
    restart: always

  # 2. HARDWARE-ACCELERATED CI/CD (Forgejo Runner)
  forgejo-runner:
    image: codeberg.org/forgejo/runner:13
    container_name: forgejo-runner
    depends_on:
      - forgejo
    volumes:
      - /var/lib/forgejo-runner:/data
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - FORGEJO_RUNNER_LABELS=ubuntu-latest:docker://node:20-bookworm,gpu-accelerated:docker://nvidia/cuda:12.6.0-base-ubuntu22.04
      - NVIDIA_VISIBLE_DEVICES=1 # Isolates pipelines strictly to your second RTX A4000 (GPU 1)
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    restart: always
